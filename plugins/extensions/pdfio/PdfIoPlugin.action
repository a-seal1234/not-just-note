<?xml version="1.0" encoding="UTF-8"?>
<ActionCollection version="2" name="Krita">
  <Actions category="Krita">
     <text>PDF Notebook</text>

     <Action name="pdfio_open_notebook">
       <icon></icon>
       <text>Import PDF as notebook</text>
       <whatsThis></whatsThis>
       <toolTip></toolTip>
       <iconText></iconText>
       <!-- 0 is "always activate": this action creates the first document, so it must be live on
            the first screen where there is no image or active device to satisfy any other flag.
            The flags are parsed as base 2; 10000 used to mean ACTIVE_DEVICE and greyed it out. -->
       <activationFlags>0</activationFlags>
       <activationConditions>0</activationConditions>
       <shortcut></shortcut>
       <isCheckable>false</isCheckable>
       <statusTip></statusTip>
     </Action>

     <Action name="pdfio_open_bundle">
       <icon></icon>
       <text>Open a notebook file</text>
       <whatsThis></whatsThis>
       <toolTip></toolTip>
       <iconText></iconText>
       <!-- Same as the import above: opening a notebook file must work with nothing open. -->
       <activationFlags>0</activationFlags>
       <activationConditions>0</activationConditions>
       <shortcut></shortcut>
       <isCheckable>false</isCheckable>
       <statusTip></statusTip>
     </Action>

     <Action name="pdfio_insert_image">
       <icon></icon>
       <text>Insert image...</text>
       <whatsThis></whatsThis>
       <toolTip></toolTip>
       <iconText></iconText>
       <!-- 10000 is binary ACTIVE_DEVICE: an image goes onto the page that is open, so this entry is
            greyed with nothing open, exactly like the document block below it. -->
       <activationFlags>10000</activationFlags>
       <activationConditions>0</activationConditions>
       <shortcut></shortcut>
       <isCheckable>false</isCheckable>
     </Action>

     <Action name="pdfio_save_page">
       <icon></icon>
       <text>Save the page notes</text>
       <whatsThis></whatsThis>
       <toolTip></toolTip>
       <iconText></iconText>
       <activationFlags>10000</activationFlags>
       <activationConditions>0</activationConditions>
       <shortcut></shortcut>
       <isCheckable>false</isCheckable>
       <statusTip></statusTip>
     </Action>

     <Action name="pdfio_strip_mode">
       <icon></icon>
       <text>Five-page strip (active ±2)</text>
       <whatsThis></whatsThis>
       <toolTip></toolTip>
       <iconText></iconText>
       <!-- 0 is "always activate": a plugin setting, not a document operation, so it is settable
            with nothing open just like the import above. -->
       <activationFlags>0</activationFlags>
       <activationConditions>0</activationConditions>
       <shortcut></shortcut>
       <isCheckable>true</isCheckable>
       <statusTip></statusTip>
     </Action>

     <Action name="pdfio_follow_scrolling">
       <icon></icon>
       <text>Turn pages by panning</text>
       <whatsThis></whatsThis>
       <toolTip></toolTip>
       <iconText></iconText>
       <!-- Same as the strip switch: a setting, so always activate. -->
       <activationFlags>0</activationFlags>
       <activationConditions>0</activationConditions>
       <shortcut></shortcut>
       <isCheckable>true</isCheckable>
       <statusTip></statusTip>
     </Action>

     <Action name="pdfio_save_notebook">
       <icon></icon>
       <text>Save the notebook</text>
       <whatsThis></whatsThis>
       <toolTip></toolTip>
       <iconText></iconText>
       <activationFlags>10000</activationFlags>
       <activationConditions>0</activationConditions>
       <shortcut></shortcut>
       <isCheckable>false</isCheckable>
       <statusTip></statusTip>
     </Action>

     <Action name="pdfio_save_bundle">
       <icon></icon>
       <text>Save the notebook as one file</text>
       <whatsThis></whatsThis>
       <toolTip></toolTip>
       <iconText></iconText>
       <activationFlags>10000</activationFlags>
       <activationConditions>0</activationConditions>
       <shortcut></shortcut>
       <isCheckable>false</isCheckable>
       <statusTip></statusTip>
     </Action>

     <Action name="pdfio_export_pdf">
       <icon></icon>
       <text>Export the notebook to PDF</text>
       <whatsThis></whatsThis>
       <toolTip></toolTip>
       <iconText></iconText>
       <activationFlags>10000</activationFlags>
       <activationConditions>0</activationConditions>
       <shortcut></shortcut>
       <isCheckable>false</isCheckable>
       <statusTip></statusTip>
     </Action>

     <Action name="pdfio_next_page">
       <icon></icon>
       <text>Next page</text>
       <whatsThis></whatsThis>
       <toolTip></toolTip>
       <iconText></iconText>
       <activationFlags>10000</activationFlags>
       <activationConditions>0</activationConditions>
       <shortcut>PgDown</shortcut>
       <isCheckable>false</isCheckable>
       <statusTip></statusTip>
     </Action>

     <Action name="pdfio_previous_page">
       <icon></icon>
       <text>Previous page</text>
       <whatsThis></whatsThis>
       <toolTip></toolTip>
       <iconText></iconText>
       <activationFlags>10000</activationFlags>
       <activationConditions>0</activationConditions>
       <shortcut>PgUp</shortcut>
       <isCheckable>false</isCheckable>
       <statusTip></statusTip>
     </Action>
  </Actions>
</ActionCollection>
